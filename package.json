{
  "name": "veritas-gate",
  "version": "2.0.0",
  "description": "Privacy-Preserving Corporate Whistleblower Portal on Midnight",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run compile && tsc --noEmit && vite build",
    "preview": "vite preview",
    "compile": "wsl -e bash -c \"~/.compact/bin/compactc contracts/veritas-gate.compact managed/\"",
    "compile:skip-zk": "wsl -e bash -c \"~/.compact/bin/compactc --skip-zk contracts/veritas-gate.compact managed/\"",
    "test": "vitest run tests/",
    "test:watch": "vitest tests/",
    "deploy:preview": "tsx src/deploy.ts preview",
    "deploy:preprod": "tsx src/deploy.ts preprod"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "whistleblower",
    "privacy",
    "governance",
    "lace-wallet"
  ],
  "author": "Veritas Gate Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.8"
  }
}
